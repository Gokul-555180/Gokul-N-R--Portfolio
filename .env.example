# Optional server-only token. When present, the activity calendar uses GitHub GraphQL.
# Leave empty to use the public contribution-calendar fallback instead.
GITHUB_TOKEN=

# Optional override. By default, the username is derived from the GitHub profile URL in data/portfolio.ts.
GITHUB_USERNAME=

# Public site metadata. These are safe to expose to the browser.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_LINKEDIN_URL=
